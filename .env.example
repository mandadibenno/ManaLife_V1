# Public Supabase settings (safe for the browser). NEVER put a service_role / secret key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Optional: the public address used in invite links (defaults to https://app.pramodbenno.in
# on localhost/native apps, and to the current site elsewhere).
# VITE_PUBLIC_APP_URL=https://app.example.com

# Optional: allow the local sample-data demo in a production build when Supabase isn't configured.
# VITE_ENABLE_DEMO=true
